{
  "name": "ShopSmart Chatbot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "ShopSmart Streamlit app",
      "onAutoForward": "openBrowser"
    }
  },
  "containerEnv": {
    "CHATBOT_MODE": "demo"
  }
}
